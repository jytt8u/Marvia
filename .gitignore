# сборка
/bin/
*.exe

# ключи, токены и локальные конфиги — не должны попасть в историю ни при каких условиях
*.key
*.pem
clients.txt
users.json
config.local.*
.env

# база панели: в ней токены подписок и хеши токенов нод
*.db
*.db-wal
*.db-shm

# учёт трафика ноды
*.usage.json
.usage-*.tmp
*.access
.access-*.tmp

# ключи подписи приложения: подпись — личность приложения на всю жизнь
*.jks
*.keystore
veil-release.properties

# драйвер сетевого адаптера: подписанный чужой бинарник, в репозитории ему не место
*.dll

# Сборки. Бинарники в репозитории не место: их качает каждый клонирующий,
# а проверить их нельзя. Готовые лежат в релизах.
dist/

# Результат gomobile bind. Собирается скриптом, в репозитории не нужен.
android/app/libs/*.aar
android/app/libs/*-sources.jar

# Черновики с холста. Исходники дизайна живут отдельно, в репозитории
# продукта им не место.
design/
