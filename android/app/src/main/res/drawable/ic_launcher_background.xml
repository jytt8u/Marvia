<?xml version="1.0" encoding="utf-8"?>
<!--
    Фон иконки — не ровный чёрный, а тот же мягкий свет, что за кнопкой в
    приложении: сверху светлее. На тёмных обоях ровный #0F1218 сливался с
    фоном, и от иконки оставался серый знак без формы.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <size android:width="108dp" android:height="108dp" />
    <gradient
        android:angle="270"
        android:endColor="#FF0B0D12"
        android:startColor="#FF262B35"
        android:type="linear" />
</shape>
