<?xml version="1.0" encoding="utf-8"?>
<!-- Тематическая иконка: силуэт знака, цвет задаёт Android. Размер слоя — 108 dp, см. ic_launcher_foreground. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:width="60dp" android:height="43dp" android:gravity="center">
        <bitmap android:src="@drawable/marvia_mark" android:gravity="fill"
            android:filter="true" android:tint="#FFFFFFFF" />
    </item>
</layer-list>
