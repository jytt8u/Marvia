<?xml version="1.0" encoding="utf-8"?>
<!-- Два статичных начертания, обычное и жирное: из переменного файла Android до 8.0 берёт только обычное, и жирное выходило бы искусственным утолщением. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <font android:fontStyle="normal" android:fontWeight="400" android:font="@font/inter_regular" app:fontStyle="normal" app:fontWeight="400" app:font="@font/inter_regular" />
    <font android:fontStyle="normal" android:fontWeight="700" android:font="@font/inter_bold" app:fontStyle="normal" app:fontWeight="700" app:font="@font/inter_bold" />
</font-family>
