<?xml version="1.0" encoding="utf-8"?>
<!--
    Средняя насыщенность переменного шрифта. На Android 8 и новее берётся ось
    веса, старее — обычное начертание: там осей нет, и подделывать их нечем.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/onest"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500"
        app:font="@font/onest"
        app:fontStyle="normal"
        app:fontWeight="500"
        app:fontVariationSettings="'wght' 500" />
</font-family>
