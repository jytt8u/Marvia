<?xml version="1.0" encoding="utf-8"?>
<!--
    Одна нода внутри карточки подписки: флаг, страна, город с именем и
    состоянием, полоски сигнала и отклик. Между строками — линия карточки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="11dp">

    <!-- Флаг. Страну не узнали — места он не занимает: выдумывать флаг нельзя. -->
    <TextView
        android:id="@+id/nodeFlag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textSize="24sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:tag="fg"
            android:textColor="@color/veil_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Здесь же разводятся «выбрана» и «трафик идёт сейчас»: это разное. -->
        <TextView
            android:id="@+id/nodeNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:tag="dim"
            android:textColor="@color/veil_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <io.marvia.android.SignalBars
        android:id="@+id/nodeBars"
        android:layout_width="22dp"
        android:layout_height="14dp"
        android:layout_marginStart="10dp" />

    <TextView
        android:id="@+id/nodePing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/jetbrains_mono"
        android:minWidth="52dp"
        android:gravity="end"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
