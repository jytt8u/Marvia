<?xml version="1.0" encoding="utf-8"?>
<!--
    Провайдер на «Серверах»: шапка (свернуть, имя, давность, обновить,
    замерить, ещё), строка срока и остатка, ниже — ноды из item_node.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:tag="card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingVertical="12dp">

        <LinearLayout
            android:id="@+id/providerHead"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="38dp">

            <ImageView
                android:id="@+id/providerChevron"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right"
                android:tag="icon:dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/providerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:tag="fg"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/providerMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/providerAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="@font/mono"
            android:tag="dim"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/providerRefresh"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/servers_refresh">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_refresh"
                android:tag="icon:fg" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/providerMeasure"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/servers_measure">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_gauge"
                android:tag="icon:fg" />

            <ProgressBar
                android:id="@+id/providerSpinner"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/providerMore"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="5dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/servers_more">

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_dots"
                android:tag="icon:fg" />
        </FrameLayout>
    </LinearLayout>

    <!-- Срок и остаток: столько дней, полоса, столько гигабайт. Пусто — продавец не ставил. -->
    <LinearLayout
        android:id="@+id/providerQuota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/providerDays"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="dim"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/providerTrack"
            android:layout_width="0dp"
            android:layout_height="5dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="10dp"
            android:tag="track">

            <View
                android:id="@+id/providerFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:tag="fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/providerLeft"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mono"
            android:tag="fg"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/providerRule"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:tag="line" />

    <TextView
        android:id="@+id/providerNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:tag="dim"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/providerNodes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
