<?xml version="1.0" encoding="utf-8"?>
<!--
    Главный экран по макету «Туннель»: знак сверху (нажатие показывает имя),
    диск с дугой, состояние и строка ноды, внизу — «Сегодня» по часам и две
    плитки. Цвета ставит Paint по тегам.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:clipChildren="false">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:paddingStart="22dp" android:paddingEnd="16dp"
        android:paddingTop="@dimen/header_pad" android:paddingBottom="0dp">
        <FrameLayout android:id="@+id/heroMarkButton" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/app_name">
            <io.marvia.android.MarviaLogoView android:id="@+id/heroMark" android:layout_width="40dp" android:layout_height="34dp"
                android:layout_gravity="center" android:contentDescription="@null" />
            <!-- Своя картинка вместо знака — из темы, «Ещё → Значок в шапке». -->
            <ImageView android:id="@+id/heroCustom" android:layout_width="34dp" android:layout_height="34dp"
                android:layout_gravity="center" android:scaleType="centerCrop" android:contentDescription="@null" android:visibility="gone" />
        </FrameLayout>
        <LinearLayout android:id="@+id/heroName" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/heroWord" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/unbounded" android:textStyle="bold" android:textSize="18sp"
                android:letterSpacing="0.10" android:includeFontPadding="false" android:text="@string/app_name_caps" android:tag="fg" />
            <TextView android:id="@+id/heroTagline" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textSize="11sp"
                android:text="@string/hero_subtitle" android:tag="dim" />
        </LinearLayout>
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:clipToPadding="false" android:clipChildren="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal" android:paddingHorizontal="16dp"
            android:paddingBottom="16dp" android:clipChildren="false">

            <!-- Кнопка над ореолом: пятно и кольца уходят за края диска и дальше — за
                 сцену, под шапку. Ни один родитель их не режет: ровный срез
                 кольца читался как обрезанный экран. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_stage_height"
                android:clipChildren="false">

                <io.marvia.android.HaloView
                    android:id="@+id/halo"
                    android:layout_width="match_parent"
                    android:layout_height="360dp"
                    android:layout_gravity="center" />

                <io.marvia.android.PowerButton
                    android:id="@+id/powerAction"
                    android:layout_width="@dimen/hero_button_size"
                    android:layout_height="@dimen/hero_button_size"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_connect" />
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/status_off"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:accessibilityLiveRegion="polite" />

            <TextView android:id="@+id/powerHint" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center" android:tag="dim"
                android:text="@string/power_hint_start" android:textSize="13sp" />

            <!-- Нода одной строкой: страна · город · отклик. Нажатие ведёт к выбору. -->
            <TextView
                android:id="@+id/nodeLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingHorizontal="18dp"
                android:fontFamily="@font/mono"
                android:letterSpacing="0.04"
                android:tag="node"
                android:textSize="13sp" />

            <TextView android:id="@+id/nodeNote" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center" android:tag="dim" android:textSize="13sp" android:lineSpacingExtra="3dp" />
            <TextView android:id="@+id/techText" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:textIsSelectable="true" android:textSize="12sp" android:visibility="gone" />

            <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="18dp" />

            <!-- Сегодня по часам. -->
            <LinearLayout
                android:id="@+id/todayCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:tag="card feature"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="true">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:text="@string/stats_today" android:tag="dim" android:textSize="14sp" />
                    <TextView android:id="@+id/todayTotal" android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/mono" android:textStyle="bold" android:tag="acc" android:textSize="22sp" />
                </LinearLayout>
                <io.marvia.android.HourBars android:id="@+id/todayBars" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:fontFamily="@font/mono" android:text="00" android:tag="dim" android:textSize="10sp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="@font/mono" android:text="23" android:tag="dim" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/tilesRow" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:orientation="horizontal" android:baselineAligned="false" android:tag="gap">
                <LinearLayout android:id="@+id/sessionCard" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginEnd="6dp" android:background="@drawable/bg_card" android:orientation="vertical"
                    android:tag="card" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_session" android:tag="dim" android:textSize="13sp" />
                    <TextView android:id="@+id/sessionValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:fontFamily="@font/mono" android:textStyle="bold" android:tag="fg"
                        android:textSize="20sp" android:text="00:00:00" android:maxLines="1"
                        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="13sp" app:autoSizeMaxTextSize="20sp" app:autoSizeStepGranularity="1sp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/speedCard" android:clickable="true" android:focusable="true" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="6dp" android:background="@drawable/bg_card" android:orientation="vertical"
                    android:tag="card" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/stats_speed" android:tag="dim" android:textSize="13sp" />
                    <TextView android:id="@+id/speedValue" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:fontFamily="@font/mono" android:textStyle="bold" android:tag="fg"
                        android:textSize="20sp" android:maxLines="1"
                        app:autoSizeTextType="uniform" app:autoSizeMinTextSize="13sp" app:autoSizeMaxTextSize="20sp" app:autoSizeStepGranularity="1sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
