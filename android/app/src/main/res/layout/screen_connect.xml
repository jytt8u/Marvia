<?xml version="1.0" encoding="utf-8"?>
<!--
    Главная из макета: знак в шапке, кнопка с дугой в кольцах, состояние
    заголовком и строка страны под ним, внизу — сегодня по часам, сессия и
    скорость. Подписка (срок, остаток) — карточкой, когда продавец её задал.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="0dp">

        <!--
            Знак один, без надписи: нажатие показывает её вместе с версией.
            Это из макета — надпись есть, но не мозолит глаза каждый день.
        -->
        <io.marvia.android.MarviaLogoView
            android:id="@+id/heroMark"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:id="@+id/heroName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart"
                android:src="@drawable/ic_wordmark"
                android:tag="icon:fg"
                app:tint="@color/veil_text" />

            <TextView
                android:id="@+id/heroVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/jetbrains_mono"
                android:letterSpacing="0.16"
                android:tag="dim"
                android:textColor="@color/veil_muted"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/headerUntil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="dim"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_pad"
            android:paddingBottom="16dp">

            <!-- Кольца расходятся от центра кнопки на весь экран: они за ней. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">

                <io.marvia.android.Halo
                    android:id="@+id/halo"
                    android:layout_width="match_parent"
                    android:layout_height="252dp" />

                <io.marvia.android.PowerButton
                    android:id="@+id/powerAction"
                    android:layout_width="252dp"
                    android:layout_height="252dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/action_connect" />
            </FrameLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:letterSpacing="-0.01"
                android:text="@string/status_off"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Страна · город · отклик, моноширинным, как в макете. Нажатие ведёт к выбору. -->
            <TextView
                android:id="@+id/nodeLine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="center"
                android:letterSpacing="0.04"
                android:minHeight="32dp"
                android:paddingHorizontal="12dp"
                android:tag="dim"
                android:textColor="@color/veil_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nodeNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:tag="dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/techText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textIsSelectable="true"
                android:textSize="12sp"
                android:visibility="gone" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <io.marvia.android.TrafficPanel
                android:id="@+id/trafficPanel"
                android:layout_width="match_parent"
                android:layout_height="192dp"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/subCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:tag="card.pad"
                android:paddingHorizontal="16dp"
                android:paddingVertical="15dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/trafficLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/traffic_left"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/trafficValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:tag="fg"
                        android:textColor="@color/veil_text"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/trafficTrack"
                    android:layout_width="match_parent"
                    android:layout_height="7dp"
                    android:layout_marginTop="11dp"
                    android:background="@drawable/bg_track"
                    android:tag="track"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/trafficFill"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@color/veil_accent"
                        android:tag="fill" />

                    <View
                        android:id="@+id/trafficRest"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0" />
                </LinearLayout>

                <TextView
                    android:id="@+id/untilLine"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="11dp"
                    android:tag="dim"
                    android:textColor="@color/veil_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
