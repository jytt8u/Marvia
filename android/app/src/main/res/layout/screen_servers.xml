<?xml version="1.0" encoding="utf-8"?>
<!--
    Серверы из макета: заголовок со счётом подписок и серверов, две кнопки
    справа — перезамер и добавление, — карточка автовыбора и по карточке на
    подписку. Внутри рабочей подписки — её серверы; остальные свёрнуты.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_pad"
        android:paddingEnd="16dp"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="-0.01"
                android:tag="fg"
                android:text="@string/servers_title"
                android:textColor="@color/veil_text"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/serversSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:tag="dim"
                android:textColor="@color/veil_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/measureSpinner"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <!-- Перезамер всех нод с этого телефона: он не мгновенный. -->
        <ImageView
            android:id="@+id/measureButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/servers_measure"
            android:foreground="?attr/selectableItemBackground"
            android:scaleType="center"
            android:src="@drawable/ic_refresh"
            android:tag="icon:fg"
            app:tint="@color/veil_text" />

        <!-- Добавить подписку: буфер обмена или руками. -->
        <ImageView
            android:id="@+id/addSubscription"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_accent_button"
            android:contentDescription="@string/servers_add"
            android:foreground="?attr/selectableItemBackground"
            android:scaleType="center"
            android:src="@drawable/ic_plus"
            android:tag="icon:accFg"
            app:tint="@color/veil_on_accent" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="16dp">

            <!--
                Автовыбор отдельной карточкой сверху, а не галочкой в списке:
                это не одна из стран, а отказ выбирать страну вручную.
            -->
            <LinearLayout
                android:id="@+id/autoRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:minHeight="66dp"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <ImageView
                    android:id="@+id/autoIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_card"
                    android:contentDescription="@null"
                    android:scaleType="center"
                    android:src="@drawable/ic_bolt"
                    android:tag="icon:fg"
                    app:tint="@color/veil_text" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/onest_medium"
                        android:maxLines="1"
                        android:text="@string/servers_auto"
                        android:tag="fg"
                        android:textColor="@color/veil_text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/autoNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/autoMark"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="11dp"
                    android:background="@drawable/bg_ring">

                    <ImageView
                        android:id="@+id/autoMarkCheck"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_check"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>

            <!-- По карточке на подписку; собирается кодом. -->
            <LinearLayout
                android:id="@+id/providerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!--
                Пока туннель не поднят, мерить нечем: ноды известны ядру, а
                ядро живёт внутри туннеля. Обещать список до подключения было
                бы обманом.
            -->
            <TextView
                android:id="@+id/serversEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="4dp"
                android:tag="dim"
                android:textColor="@color/veil_muted"
                android:textSize="13.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
