<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.2"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:tag="dim"
            android:textColor="@color/veil_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="-0.02"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingBottom="8dp"
        android:text="@string/settings_title"
        android:tag="fg"
        android:textColor="@color/veil_text"
        android:textSize="26sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/screen_pad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="18dp">

            <!--
                Первым — то, что чинит «интернет тормозит»: не всё нужно вести
                через туннель. Потом ключ доступа, который трогают раз. Вид живёт
                на своей вкладке: его выбирают глядя, а не из списка.
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:tag="card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowAutostart"
                    style="@style/VeilRow">

                    <TextView
                        style="@style/VeilRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_autostart" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchAutostart"
                        android:tag="switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:id="@+id/dividerRu"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="line"
                    android:background="@color/veil_border" />

                <!--
                    Российские сайты мимо туннеля. Строки нет вовсе на Android
                    старше 13: там система не умеет исключать маршруты, и
                    переключатель обещал бы то, чего не будет.
                -->
                <LinearLayout
                    android:id="@+id/rowRussian"
                    style="@style/VeilRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VeilRowTitle"
                            android:text="@string/settings_russian" />

                        <TextView
                            style="@style/VeilRowSub"
                            android:text="@string/settings_russian_sub" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchRussian"
                        android:tag="switch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="false"
                        android:focusable="false" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="line"
                    android:background="@color/veil_border" />

                <LinearLayout
                    android:id="@+id/rowApps"
                    style="@style/VeilRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VeilRowTitle"
                            android:text="@string/settings_apps" />

                        <TextView
                            android:id="@+id/appsSummary"
                            style="@style/VeilRowSub" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tag="icon:dim"
                        app:tint="@color/veil_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="line"
                    android:background="@color/veil_border" />

                <LinearLayout
                    android:id="@+id/rowAlwaysOn"
                    style="@style/VeilRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VeilRowTitle"
                            android:text="@string/settings_always_on" />

                        <TextView
                            style="@style/VeilRowSub"
                            android:text="@string/settings_always_on_sub" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tag="icon:dim"
                        app:tint="@color/veil_chevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:tag="card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rowKey"
                    style="@style/VeilRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VeilRowTitle"
                            android:text="@string/settings_key" />

                        <TextView
                            android:id="@+id/keySummary"
                            style="@style/VeilRowSub"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tag="icon:dim"
                        app:tint="@color/veil_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="line"
                    android:background="@color/veil_border" />

                <LinearLayout
                    android:id="@+id/rowJournal"
                    style="@style/VeilRow">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/VeilRowTitle"
                            android:text="@string/settings_journal" />

                        <TextView
                            style="@style/VeilRowSub"
                            android:text="@string/settings_journal_sub" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tag="icon:dim"
                        app:tint="@color/veil_chevron" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:tag="line"
                    android:background="@color/veil_border" />

                <LinearLayout
                    android:id="@+id/rowAbout"
                    style="@style/VeilRow">

                    <TextView
                        style="@style/VeilRowTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_about" />

                    <ImageView
                        android:layout_width="19dp"
                        android:layout_height="19dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron"
                        android:tag="icon:dim"
                        app:tint="@color/veil_chevron" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
