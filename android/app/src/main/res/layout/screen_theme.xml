<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема: готовые виды, акцент, плотность. Всё применяется сразу — этот же
    экран и есть предпросмотр, поэтому отдельной картинки «как будет» нет.

    Сетки видов и акцентов собираются кодом: их содержимое приходит из
    таблицы тем, а не из разметки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="10dp">

        <!-- Надпись — форма, а не шрифт: «A» с точкой. Цвет даёт тема. -->
        <ImageView
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:adjustViewBounds="true"
            android:scaleType="fitStart"
            android:src="@drawable/ic_wordmark"
            android:contentDescription="@string/app_name"
            android:tag="icon:dim"
            app:tint="@color/veil_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:tag="fg"
            android:text="@string/theme_title"
            android:textColor="@color/veil_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:tag="dim"
            android:text="@string/theme_hint"
            android:textColor="@color/veil_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/screen_pad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <!--
                Телефон с главным экраном в выбранной теме. Внутри карточки,
                чтобы у корпуса был фон, на котором его видно и в светлой теме.
            -->
            <FrameLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:tag="card"
                android:paddingTop="14dp">

                <io.marvia.android.ThemePreview
                    android:id="@+id/previewPower"
                    android:layout_width="match_parent"
                    android:layout_height="168dp"
                    android:layout_gravity="center_horizontal"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:gravity="center"
                android:tag="dim"
                android:text="@string/theme_preview"
                android:textColor="@color/veil_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <TextView
                    style="@style/VeilSection"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:tag="dim"
                    android:text="@string/theme_looks" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="dim"
                    android:text="@string/theme_looks_hint"
                    android:textColor="@color/veil_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Три колонки мини-макетов: заполняется кодом из таблицы. -->
            <LinearLayout
                android:id="@+id/looksGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/themeExpand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_pill"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="46dp"
                android:tag="chip"
                android:text="@string/theme_show_all"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/themeAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:minHeight="46dp"
                android:tag="chip"
                android:text="@string/theme_advanced"
                android:textSize="14sp" />
            <LinearLayout android:id="@+id/advancedControls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <!-- Профили и код темы: то, что уезжает другу и в другие клиенты. -->
            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_profiles" />

            <LinearLayout
                android:id="@+id/profileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/profileSave"
                    style="@style/VeilPill"
                    android:text="@string/theme_save_here" />

                <TextView
                    android:id="@+id/themeRandom"
                    style="@style/VeilPill"
                    android:layout_marginStart="6dp"
                    android:text="@string/theme_random" />
            </LinearLayout>

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_code" />

            <TextView
                android:id="@+id/themeCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:tag="fg"
                android:textColor="@color/veil_text"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/codeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:hint="@string/theme_code_placeholder"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:maxLines="1"
                android:paddingHorizontal="14dp"
                android:paddingVertical="11dp"
                android:tag="fg"
                android:textColor="@color/veil_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/codeBad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingHorizontal="3dp"
                android:tag="fail"
                android:text="@string/theme_code_bad"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_accent" />

            <LinearLayout
                android:id="@+id/accentRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <!-- Свет: откуда светит (лампа), характер, густота тени, оттенок. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <TextView
                    style="@style/VeilSection"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:tag="dim"
                    android:text="@string/theme_light" />

                <TextView
                    android:id="@+id/lightNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:tag="acc"
                    android:textColor="@color/veil_accent"
                    android:textSize="10sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/lamp"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="9dp">

                <GridLayout
                    android:id="@+id/lampZones"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:columnCount="3"
                    android:rowCount="3" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:gravity="center"
                    android:paddingBottom="6dp"
                    android:tag="dim"
                    android:text="@string/theme_lamp_hint"
                    android:textColor="@color/veil_muted"
                    android:textSize="11sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/kindsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:tag="fg"
                    android:text="@string/theme_depth"
                    android:textColor="@color/veil_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/depthNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:tag="dim"
                    android:textColor="@color/veil_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/depthSeek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="90" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_tint" />

            <LinearLayout
                android:id="@+id/tintRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_cards" />

            <LinearLayout
                android:id="@+id/cardRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_radius" />

            <LinearLayout
                android:id="@+id/radiusRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_density" />

            <LinearLayout
                android:id="@+id/densityRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_button" />

            <LinearLayout
                android:id="@+id/buttonRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_glow" />

            <LinearLayout
                android:id="@+id/glowRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal" />

            <!-- Свой фон: фото за интерфейсом. Файл остаётся в приложении и в
                 код темы не входит — код передают, а файл с ним не унесёшь. -->
            <TextView
                style="@style/VeilSection"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_backdrop" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/bgPick"
                    style="@style/VeilPill"
                    android:layout_weight="2"
                    android:text="@string/theme_backdrop_pick" />

                <TextView
                    android:id="@+id/bgDrop"
                    style="@style/VeilPill"
                    android:layout_marginStart="6dp"
                    android:text="@string/theme_backdrop_drop"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/bgKnobs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="14dp"
                    android:paddingHorizontal="3dp"
                    android:tag="dim"
                    android:text="@string/theme_backdrop_fit" />

                <LinearLayout
                    android:id="@+id/bgFits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="3dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:tag="fg"
                        android:text="@string/theme_backdrop_dim"
                        android:textColor="@color/veil_text"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/bgDimNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/bgDimSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="95" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_backdrop_note"
                android:textColor="@color/veil_muted"
                android:textSize="12.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:paddingHorizontal="3dp"
                android:tag="dim"
                android:text="@string/theme_note"
            android:textColor="@color/veil_muted"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/themeReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:foreground="?attr/selectableItemBackground"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:tag="chip"
                android:text="@string/theme_reset"
            android:textColor="@color/veil_muted"
                android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
