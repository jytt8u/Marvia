<?xml version="1.0" encoding="utf-8"?>
<!--
    «Тема» по макету: сверху предпросмотр (настоящие экраны в масштабе, с
    переворотом при смене), под ним вкладки Цвет · Свет · Фон · Форма · Ещё,
    и разделы той вкладки, что открыта. Ряды кнопок собирает код.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="16dp"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_title"
            android:tag="fg"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/theme_hint"
            android:tag="dim"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/themeScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!--
                Предпросмотр: телефон в масштабе слева, справа — какой экран
                показать. Вкладки «Форма» и «Ещё» приближают телефон к тому, что
                меняют: карточкам настроек и заголовку. Размеры и сдвиг ставит код.
            -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:tag="card">

                <FrameLayout
                    android:id="@+id/previewFrame"
                    android:layout_width="133dp"
                    android:layout_height="287dp"
                    android:clipChildren="true">

                    <FrameLayout
                        android:id="@+id/previewStage"
                        android:layout_width="390dp"
                        android:layout_height="844dp"
                        android:clipChildren="true" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/previewPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Вкладки: значок в таблетке и подпись, как нижняя панель. -->
            <LinearLayout
                android:id="@+id/tabsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/tabHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:tag="dim"
                android:textSize="12sp" />

            <!-- ==================================================== Цвет -->
            <LinearLayout
                android:id="@+id/tabColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_looks_caps" />
                        <TextView android:id="@+id/lookName" style="@style/ThemeHint" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/looksStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_accent_caps" />
                        <TextView style="@style/ThemeHint" android:text="@string/theme_accent_hint" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/accentStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp" />
                    </HorizontalScrollView>
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_tint_caps" />
                        <TextView android:id="@+id/tintName" style="@style/ThemeHint" />
                    </LinearLayout>
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">
                        <LinearLayout
                            android:id="@+id/tintStrip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp" />
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>

            <!-- ==================================================== Свет -->
            <LinearLayout
                android:id="@+id/tabLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_light_caps" />
                        <TextView android:id="@+id/lightNote" style="@style/ThemeHint" />
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/lamp"
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:layout_marginTop="10dp">
                        <GridLayout
                            android:id="@+id/lampZones"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:columnCount="3"
                            android:rowCount="3"
                            android:padding="6dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="8dp"
                            android:text="@string/theme_lamp_hint"
                            android:tag="dim"
                            android:textSize="11sp" />
                    </FrameLayout>
                    <LinearLayout
                        android:id="@+id/kindsRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_depth_caps" />
                        <TextView android:id="@+id/depthNote" style="@style/ThemeHint" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/depthSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="90" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="4dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/mono" android:letterSpacing="0.16" android:tag="dim" android:text="@string/theme_depth_light" android:textSize="9.5sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/mono" android:letterSpacing="0.16" android:tag="dim" android:text="@string/theme_depth_dark" android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===================================================== Фон -->
            <LinearLayout
                android:id="@+id/tabBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_pattern_caps" />
                        <TextView style="@style/ThemeHint" android:text="@string/theme_pattern_hint" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/patternRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_backdrop_caps" />
                        <TextView android:id="@+id/bgNote" style="@style/ThemeHint" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/bgPick" style="@style/VeilPill" android:layout_marginEnd="6dp" />
                        <TextView android:id="@+id/bgDrop" style="@style/VeilPill" android:text="@string/theme_backdrop_drop" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/bgKnobs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView style="@style/ThemeK" android:layout_marginTop="14dp" android:text="@string/theme_backdrop_fit" />
                        <LinearLayout
                            android:id="@+id/bgFits"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal" />
                        <LinearLayout style="@style/ThemeSectionHead" android:layout_marginTop="14dp">
                            <TextView style="@style/ThemeK" android:text="@string/theme_backdrop_dim" />
                            <TextView android:id="@+id/bgDimNote" style="@style/ThemeHint" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/bgDimSeek"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="95" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/theme_backdrop_note"
                        android:tag="dim"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- =================================================== Форма -->
            <LinearLayout
                android:id="@+id/tabShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_cards_caps" />
                    <LinearLayout android:id="@+id/cardRow" style="@style/ThemeRow" />
                </LinearLayout>
                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_radius_caps" />
                    <LinearLayout android:id="@+id/radiusRow" style="@style/ThemeRow" />
                </LinearLayout>
                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_density_caps" />
                    <LinearLayout android:id="@+id/densityRow" style="@style/ThemeRow" />
                </LinearLayout>
                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_button_caps" />
                    <LinearLayout android:id="@+id/buttonRow" style="@style/ThemeRow" />
                </LinearLayout>
                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_glow_caps" />
                    <LinearLayout android:id="@+id/glowRow" style="@style/ThemeRow" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===================================================== Ещё -->
            <LinearLayout
                android:id="@+id/tabMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_logo_caps" />
                        <TextView android:id="@+id/logoNote" style="@style/ThemeHint" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/logoRow" style="@style/ThemeRow" />
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_font_caps" />
                    <LinearLayout android:id="@+id/fontRow" style="@style/ThemeRow" />
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <LinearLayout style="@style/ThemeSectionHead">
                        <TextView style="@style/ThemeK" android:text="@string/theme_profiles_caps" />
                        <TextView style="@style/ThemeHint" android:text="@string/theme_profiles_hint" />
                    </LinearLayout>
                    <LinearLayout android:id="@+id/profileRow" style="@style/ThemeRow" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">
                        <TextView android:id="@+id/profileSave" style="@style/VeilPill" android:layout_marginEnd="6dp" android:text="@string/theme_save_here" />
                        <TextView android:id="@+id/themeRandom" style="@style/VeilPill" android:text="@string/theme_random" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/ThemeSection">
                    <TextView style="@style/ThemeK" android:text="@string/theme_code_caps" />
                    <TextView
                        android:id="@+id/themeCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/mono"
                        android:padding="12dp"
                        android:tag="fg"
                        android:textIsSelectable="false"
                        android:textSize="12sp" />
                    <EditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/mono"
                        android:hint="@string/theme_code_placeholder"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:inputType="textNoSuggestions"
                        android:padding="12dp"
                        android:singleLine="true"
                        android:tag="fg"
                        android:textSize="12sp" />
                    <TextView
                        android:id="@+id/codeBad"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:tag="fail"
                        android:text="@string/theme_code_bad"
                        android:textSize="12sp"
                        android:visibility="gone" />
                    <TextView android:id="@+id/themeReset" style="@style/VeilPill" android:layout_marginTop="10dp" android:text="@string/theme_reset" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:paddingHorizontal="8dp"
                    android:text="@string/theme_note"
                    android:tag="dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
