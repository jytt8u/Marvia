<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема из макета: предпросмотр телефона с выбором экрана, пять разделов
    круглыми значками — цвет, свет, фон, форма, ещё — и под ними ручки
    раздела. Всё применяется сразу: этот же экран и есть предпросмотр.

    Ряды видов, акцентов и прочего собираются кодом: их содержимое приходит
    из таблицы тем, а не из разметки.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_pad"
        android:paddingTop="@dimen/header_pad"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.01"
            android:tag="fg"
            android:text="@string/theme_title"
            android:textColor="@color/veil_text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:tag="dim"
            android:text="@string/theme_hint"
            android:textColor="@color/veil_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="18dp">

            <!-- Телефон с одним из трёх экранов в выбранной теме; справа — какой. -->
            <LinearLayout
                android:id="@+id/previewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="14dp"
                android:paddingVertical="18dp"
                android:tag="card">

                <io.marvia.android.ThemePreview
                    android:id="@+id/previewPower"
                    android:layout_width="0dp"
                    android:layout_height="300dp"
                    android:layout_weight="1.1"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/previewPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="14dp" />
            </LinearLayout>

            <!-- Разделы: круглый значок и подпись, активный залит. -->
            <LinearLayout
                android:id="@+id/tabRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp" />

            <!-- ЦВЕТ: готовые виды, акцент, оттенок светлой стороны. -->
            <LinearLayout
                android:id="@+id/sectionColor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/theme_looks" />

                    <TextView
                        android:id="@+id/lookName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/looksStrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/theme_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:text="@string/theme_accent_hint"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/accentRows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/theme_tint" />

                    <TextView
                        android:id="@+id/tintName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-16dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/tintRows"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- СВЕТ: откуда светит, характер, густота тени. -->
            <LinearLayout
                android:id="@+id/sectionLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/theme_light" />

                    <TextView
                        android:id="@+id/lightNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/lamp"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="10dp">

                    <GridLayout
                        android:id="@+id/lampZones"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:columnCount="3"
                        android:padding="6dp"
                        android:rowCount="3" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:tag="dim"
                        android:text="@string/theme_lamp_hint"
                        android:textColor="@color/veil_muted"
                        android:textSize="11sp" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/kindsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/onest_medium"
                        android:tag="fg"
                        android:text="@string/theme_depth"
                        android:textColor="@color/veil_text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/depthNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/depthSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="90" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="2dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jetbrains_mono"
                        android:letterSpacing="0.16"
                        android:tag="dim"
                        android:text="@string/theme_depth_light"
                        android:textColor="@color/veil_muted"
                        android:textSize="9sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:letterSpacing="0.16"
                        android:tag="dim"
                        android:text="@string/theme_depth_dark"
                        android:textColor="@color/veil_muted"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ФОН: свой файл за интерфейсом. Остаётся в приложении и в код темы не входит. -->
            <LinearLayout
                android:id="@+id/sectionBg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:baselineAligned="true"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/theme_backdrop" />

                    <TextView
                        android:id="@+id/bgNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:tag="dim"
                        android:textColor="@color/veil_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/bgPick"
                        style="@style/VeilPill"
                        android:layout_weight="2"
                        android:text="@string/theme_backdrop_pick" />

                    <TextView
                        android:id="@+id/bgDrop"
                        style="@style/VeilPill"
                        android:layout_marginStart="6dp"
                        android:text="@string/theme_backdrop_drop"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/bgKnobs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        style="@style/VeilSection"
                        android:layout_marginTop="18dp"
                        android:paddingHorizontal="4dp"
                        android:text="@string/theme_backdrop_fit" />

                    <LinearLayout
                        android:id="@+id/bgFits"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal"
                        android:paddingHorizontal="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/onest_medium"
                            android:tag="fg"
                            android:text="@string/theme_backdrop_dim"
                            android:textColor="@color/veil_text"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/bgDimNote"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="dim"
                            android:textColor="@color/veil_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/bgDimSeek"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:max="95" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingHorizontal="4dp"
                    android:tag="dim"
                    android:text="@string/theme_backdrop_note"
                    android:textColor="@color/veil_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ФОРМА: карточки, скругления, плотность, кнопка, свечение. -->
            <LinearLayout
                android:id="@+id/sectionShape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="22dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_cards" />

                <LinearLayout
                    android:id="@+id/cardRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="18dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_radius" />

                <LinearLayout
                    android:id="@+id/radiusRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="18dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_density" />

                <LinearLayout
                    android:id="@+id/densityRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="18dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_button" />

                <LinearLayout
                    android:id="@+id/buttonRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="18dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_glow" />

                <LinearLayout
                    android:id="@+id/glowRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>

            <!-- ЕЩЁ: профили, код темы, случайная, сброс. -->
            <LinearLayout
                android:id="@+id/sectionMore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Профили и код темы: то, что уезжает другу и в другие клиенты. -->
                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="22dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_profiles" />

                <LinearLayout
                    android:id="@+id/profileRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/profileSave"
                        style="@style/VeilPill"
                        android:text="@string/theme_save_here" />

                    <TextView
                        android:id="@+id/themeRandom"
                        style="@style/VeilPill"
                        android:layout_marginStart="6dp"
                        android:text="@string/theme_random" />
                </LinearLayout>

                <TextView
                    style="@style/VeilSection"
                    android:layout_marginTop="18dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/theme_code" />

                <TextView
                    android:id="@+id/themeCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/jetbrains_mono"
                    android:letterSpacing="0.04"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp"
                    android:tag="fg"
                    android:textColor="@color/veil_text"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/codeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:hint="@string/theme_code_placeholder"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:maxLines="1"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="11dp"
                    android:tag="fg"
                    android:textColor="@color/veil_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/codeBad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingHorizontal="4dp"
                    android:tag="fail"
                    android:text="@string/theme_code_bad"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingMultiplier="1.3"
                    android:paddingHorizontal="4dp"
                    android:tag="dim"
                    android:text="@string/theme_note"
                    android:textColor="@color/veil_muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/themeReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_pill"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp"
                    android:tag="chip"
                    android:text="@string/theme_reset"
                    android:textColor="@color/veil_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
