<?xml version="1.0" encoding="utf-8"?>
<!--
    Нижняя панель из макета. Своя, а не BottomNavigationView: там пять вкладок
    со своими правилами подсветки и отступов, и подгонять их под макет вышло бы
    длиннее, чем нарисовать пять кнопок.

    Активная вкладка — значок на пилюле и подпись жирнее; цвета ставит код.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/veil_surface"
    android:orientation="vertical"
    android:tag="surf">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:tag="line"
        android:background="@color/veil_border" />

    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:id="@+id/navConnect"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/navConnectIcon"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_nav_tunnel" />

            <TextView
                android:id="@+id/navConnectLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/nav_connect"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navServers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/navServersIcon"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_nav_servers" />

            <TextView
                android:id="@+id/navServersLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/nav_servers"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navStats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/navStatsIcon"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_nav_stats" />

            <TextView
                android:id="@+id/navStatsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/nav_stats"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTheme"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/navThemeIcon"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_nav_theme" />

            <TextView
                android:id="@+id/navThemeLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/nav_theme"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navMore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:gravity="center"
            android:minHeight="52dp"
            android:orientation="vertical"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/navMoreIcon"
                android:layout_width="44dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_pill"
                android:contentDescription="@null"
                android:scaleType="center"
                android:src="@drawable/ic_nav_settings" />

            <TextView
                android:id="@+id/navMoreLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:text="@string/nav_more"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
