    <!--
        Байпас. Значок VPN в шторке остаётся всегда — его рисует Android, пока
        поднят туннель. Но госуслуги ломает не значок, а зарубежный адрес
        ноды, и вот его исключение из туннеля и чинит.
    -->
    <string name="bypass_title">Что не пускать в туннель</string>
    <string name="bypass_none">Все приложения идут через туннель</string>
    <string name="bypass_some">Мимо туннеля: %1$d</string>
    <string name="bypass_preset">Госуслуги и банки</string>
    <string name="bypass_save">Сохранить</string>
    <string name="bypass_restart">Изменения применятся при следующем подключении</string>
    <string name="bypass_loading">Смотрю, что установлено…</string>

    <!--
        Российские сайты мимо туннеля. Предлагаем при первом удачном
        подключении: про эту возможность человек вспоминает ровно тогда, когда
        у него не открылись госуслуги, — то есть уже разозлившись.
    -->
    <string name="bypass_ru_title">Российские сайты — мимо туннеля?</string>
    <string name="bypass_ru_body">Госуслуги, банки и почта не отвечают на запросы из-за границы. Если увести их мимо, они будут открываться как обычно, а всё остальное пойдёт через туннель.</string>
    <string name="bypass_ru_yes">Увести мимо</string>
    <string name="bypass_ru_no">Не надо</string>

