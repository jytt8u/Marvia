<?xml version="1.0" encoding="utf-8"?>
<!--
    Английский лежит в values по умолчанию, русский — в values-ru.

    Так задумано в Android: values — запасной вариант для всех, у кого нет
    своей папки. Держать в нём русский значило бы показывать русские надписи
    человеку с турецким или персидским телефоном — а это ровно те, ради кого
    приложение и делается.

    Апостроф в английском тексте ломает сборку ресурсов, а номер строки aapt
    показывает не тот — поэтому фразы здесь построены без него.
-->
<resources>
    <string name="app_name">Marvia</string>

    <!-- Нижняя панель: три экрана и ничего больше. -->
    <string name="nav_connect">Connection</string>
    <string name="nav_servers">Countries</string>
    <string name="nav_settings">Settings</string>
    <string name="nav_theme">Theme</string>

    <!--
        Экран выбора языка двуязычный и не переводится: пока язык не выбран,
        он обязан читаться на обоих. Под каждым языком — его название на
        другом; кнопка «Продолжить» одна на два языка и переключается выбором.
    -->
    <string name="language_title" translatable="false">Выберите язык</string>
    <string name="language_subtitle" translatable="false">Choose your language</string>
    <string name="language_ru" translatable="false">Русский</string>
    <string name="language_ru_other" translatable="false">Russian</string>
    <string name="language_en" translatable="false">English</string>
    <string name="language_en_other" translatable="false">Английский</string>
    <string name="language_continue_ru" translatable="false">Продолжить</string>
    <string name="language_continue_en" translatable="false">Continue</string>
    <string name="settings_language">Language</string>

    <string name="status_off">Disconnected</string>
    <string name="status_connecting">Connecting…</string>
    <string name="status_on">Connected</string>
    <string name="status_failed">Could not connect</string>

    <string name="detail_connecting">Picking the fastest node</string>
    <string name="detail_no_key">Paste your access key</string>
    <string name="detail_node">Node: %1$s</string>

    <!-- Круг на главном экране и есть выключатель, и это стоит сказать словами. -->
    <string name="connect_tap_on">tap the circle to connect</string>
    <string name="connect_tap_off">tap the circle to disconnect</string>
    <string name="connect_no_key">no access key yet</string>

    <!--
        Выбор и текущая нода — разные вещи. Выбранная страна могла замолчать, и
        ядро уехало на живую: показывать в этом случае только выбор значило бы
        врать о том, куда идёт трафик.
    -->
    <string name="connect_auto">picked automatically, the fastest one</string>
    <string name="connect_manual">this country you picked yourself</string>
    <string name="connect_manual_moved">you picked %1$s, it went silent — traffic goes through this one</string>

    <!-- Подписка: до какого числа и сколько трафика осталось. -->
    <string name="header_until">until %1$s</string>
    <string name="traffic_left">Left</string>
    <string name="traffic_of">%1$s of %2$s</string>
    <string name="sub_until_days">Access until %1$s — that is %2$s</string>
    <string name="sub_until_only">Access until %1$s</string>
    <plurals name="days_left">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>
    <string name="size_gb">%1$s GB</string>
    <string name="size_mb">%1$d MB</string>

    <string name="action_connect">Connect</string>
    <string name="action_save">Save the key</string>

    <!-- Экран ключа. -->
    <string name="key_title">Paste the access key</string>
    <string name="key_body">Your seller sent it in the chat — a marvia://… link. Tap it right there and the app sets itself up.</string>
    <string name="key_hint_short">marvia://…</string>
    <string name="key_paste">Paste</string>
    <string name="key_footer">The key lives on this phone only. We do not see it and cannot bring it back — if you lose it, ask your seller for a new one.</string>
    <string name="key_clipboard_empty">There is no link in the clipboard</string>
    <string name="key_saved">Key saved</string>
    <string name="key_empty">The field is empty</string>

    <!--
        Ссылку приложению может подсунуть любое другое приложение или страница,
        не только бот продавца. Пока ключа нет, менять нечего — берём молча.
        Когда ключ уже стоит, подмена увела бы весь трафик на чужие серверы,
        поэтому спрашиваем.
    -->
    <string name="key_replace_title">Replace the access key?</string>
    <string name="key_replace_body">This link came from another app. After replacing it, your traffic goes through the servers of whoever issued it. Agree only if the link came from your seller.</string>
    <string name="key_replace_yes">Replace</string>
    <string name="key_replace_no">Keep the old one</string>

    <!-- Экран выбора страны. -->
    <string name="servers_title">Countries</string>
    <string name="servers_hint">Speed is measured from your phone, not from the servers of your seller.</string>
    <string name="servers_measure">Refresh</string>
    <string name="servers_auto">Automatic</string>
    <string name="servers_auto_mark">⚡</string>
    <string name="servers_auto_note">the fastest one right now is %1$s</string>
    <string name="servers_auto_unknown">tap Refresh to measure the countries</string>
    <string name="servers_manual">Pick by hand</string>
    <string name="servers_footer">If a country stops opening, the app moves to another one by itself — picking by hand is rarely needed.</string>
    <string name="servers_empty">The list lives inside the tunnel: connect, and the countries with their response times appear here.</string>
    <string name="servers_group_other">Other</string>
    <string name="servers_failed">Could not move: %1$s</string>

    <!-- Строка ноды: что с ней и куда на самом деле идёт трафик. -->
    <string name="node_ping">%1$d ms</string>
    <string name="node_ping_none">—</string>
    <string name="node_ok">works</string>
    <string name="node_down">not available right now</string>
    <string name="node_unmeasured">not measured yet</string>
    <string name="node_current">traffic goes through it right now</string>
    <string name="node_chosen_current">picked by you · traffic goes through it</string>
    <string name="node_chosen_silent">picked by you, but silent — traffic goes through %1$s</string>

    <!--
        Байпас. Значок VPN в шторке остаётся всегда — его рисует Android, пока
        поднят туннель. Но местные сервисы ломает не значок, а зарубежный адрес
        ноды, и вот его исключение из туннеля и чинит.
    -->
    <string name="bypass_title">What to keep out of the tunnel</string>
    <string name="bypass_none">Every app goes through the tunnel</string>
    <string name="bypass_some">Outside the tunnel: %1$d</string>
    <string name="bypass_preset">Government services and banks</string>
    <string name="bypass_save">Save</string>
    <string name="bypass_restart">Changes apply on the next connection</string>
    <string name="bypass_loading">Looking at what is installed…</string>

    <!--
        Местные сайты мимо туннеля. Предлагаем при первом удачном подключении:
        про эту возможность человек вспоминает ровно тогда, когда у него не
        открылся банк, — то есть уже разозлившись.
    -->
    <string name="bypass_ru_title">Local sites outside the tunnel?</string>
    <string name="bypass_ru_body">Government services, banks and mail often refuse requests from abroad. Sent outside, they open as usual, while everything else keeps going through the tunnel.</string>
    <string name="bypass_ru_yes">Send them outside</string>
    <string name="bypass_ru_no">No need</string>

    <!--
        Настройки. Здесь нет ручек протокола: их место внутри, а не на экране
        человека, который не может выбрать между ними осознанно.
    -->
    <string name="settings_title">Settings</string>
    <string name="settings_autostart">Start when the phone starts</string>
    <string name="settings_autostart_saved">The tunnel will come up by itself after a reboot</string>
    <string name="settings_autostart_off_saved">After a reboot you will have to turn it on by hand</string>
    <string name="settings_russian">Local sites outside the tunnel</string>
    <string name="settings_russian_sub">banks and government services complain otherwise</string>
    <string name="settings_apps">Apps outside the tunnel</string>
    <string name="settings_always_on">Always-on VPN in the system</string>
    <string name="settings_always_on_sub">the system brings the tunnel up earlier than we can</string>
    <string name="settings_always_on_missing">This phone has no such settings screen</string>
    <string name="settings_key">Access key</string>
    <string name="settings_key_added">added on %1$s</string>
    <string name="settings_journal">Log</string>
    <string name="settings_journal_sub">shows your seller what happened</string>
    <string name="settings_about">About</string>
    <string name="about_body">%1$s, version %2$s</string>
    <!--
        Экран темы. Названия пресетов — по ключу из таблицы internal/look:
        look_<ключ>. Тест в том пакете следит, что ни один пресет не остался
        без названия на обоих языках.
    -->
    <string name="theme_title">Theme</string>
    <string name="theme_hint">Everything applies at once</string>
    <string name="theme_looks">Ready looks</string>
    <string name="theme_looks_hint">the whole screen in one tap</string>
    <string name="theme_accent">Accent</string>
    <string name="theme_density">Density</string>
    <string name="theme_note">The theme is kept on this phone and sent nowhere. The seller panel and the desktop app use the same colour table.</string>
    <string name="theme_reset">Back to grey</string>
    <string name="density_compact">Compact</string>
    <string name="density_normal">Normal</string>
    <string name="density_roomy">Roomy</string>
    <string name="look_emerald">Emerald</string>
    <string name="look_jade">Jade</string>
    <string name="look_teal">Lagoon</string>
    <string name="look_ice">Ice</string>
    <string name="look_cobalt">Cobalt</string>
    <string name="look_ultra">Ultra</string>
    <string name="look_plum">Plum</string>
    <string name="look_orchid">Orchid</string>
    <string name="look_fuchsia">Fuchsia</string>
    <string name="look_rose">Rose</string>
    <string name="look_crimson">Crimson</string>
    <string name="look_ember">Ember</string>
    <string name="look_amber">Amber</string>
    <string name="look_gold">Gold</string>
    <string name="look_citrus">Citrus</string>
    <string name="look_lime">Lime</string>
    <string name="look_olive">Olive</string>
    <string name="look_sand">Sand</string>
    <string name="look_copper">Copper</string>
    <string name="look_steel">Grey</string>
    <string name="look_slate">Slate</string>
    <string name="look_mono">Mono</string>
    <string name="look_oled">OLED</string>
    <string name="look_midnight">Midnight</string>
    <string name="look_daylight">Daylight</string>
    <string name="look_paper">Paper</string>
    <string name="look_linen">Linen</string>
    <string name="journal_send">Send to the seller</string>

    <string name="consent_denied">The tunnel cannot start without permission from the system</string>
    <string name="error_no_interface">The system did not give out a network interface</string>

    <!--
        Фразы под виды неудач из ядра. Задача каждой — сказать человеку, что
        делать дальше, а не что именно сломалось внутри.
    -->
    <!--
        Кончившаяся подписка — самая частая беда и единственная, где человеку
        надо не чинить, а заплатить. Раньше он читал «ни один сервер не
        отвечает», шёл к продавцу с «у вас всё сломалось», и продавец
        разбирался с каждым таким вручную.
    -->
    <string name="fail_expired">Your subscription has ended. Renew it with your seller — access comes back at once</string>
    <string name="fail_quota">You are out of paid traffic. Ask your seller to add more</string>

    <string name="fail_account">The access key was not accepted. Get a new one from your seller</string>
    <string name="fail_panel">Cannot fetch the server list. Check that you have internet</string>
    <string name="fail_nodes">No server is responding right now. Try later or write to your seller</string>
    <string name="fail_system">The phone would not create the connection. Try again</string>

    <string name="notification_channel">Tunnel</string>
    <string name="notification_channel_desc">Shows whether the tunnel is running</string>
    <string name="notification_stop">Disconnect</string>

    <!--
        Строки журнала. Журнал человек отправляет продавцу, то есть читает его
        не только он, — поэтому он такой же перевод, как и всё остальное.
    -->
    <string name="log_header">Marvia · log</string>
    <string name="log_bypassed">apps outside the tunnel: %1$d</string>
    <string name="log_bypass_local">, local subnets outside: %1$s</string>
    <string name="log_yes">yes</string>
    <string name="log_no">no</string>
    <string name="log_tunnel_on">turning the tunnel on</string>
    <string name="log_connected">connected through %1$s</string>
    <string name="log_moved">node stopped answering, moved to %1$s</string>
    <string name="trouble_no_node">the node is silent and there is nowhere to move — nothing works right now</string>
    <string name="log_failed">did not come up: %1$s — %2$s</string>
</resources>
