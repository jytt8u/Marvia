<?xml version="1.0" encoding="utf-8"?>
<!--
    Тема одна на светлое и тёмное: сами цвета разведены по values и
    values-night. Второго файла темы поэтому нет — иначе одно и то же
    пришлось бы править в двух местах, и однажды поправили бы в одном.
-->
<resources>
    <style name="Theme.Veil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/veil_accent</item>
        <item name="colorOnPrimary">@color/veil_on_accent</item>
        <item name="colorSurface">@color/veil_surface</item>
        <item name="colorOnSurface">@color/veil_text</item>
        <item name="android:colorBackground">@color/veil_bg</item>
        <item name="android:textColorPrimary">@color/veil_text</item>
        <item name="android:textColorSecondary">@color/veil_muted</item>
        <!-- Шрифт макета, свой, вшитый: системный Roboto не совпал бы ни в одной строке. -->
        <item name="android:textViewStyle">@style/VeilText</item>
    </style>

    <!-- Стиль текста по умолчанию: шрифт макета. Вьюха со своим fontFamily его перекрывает. -->
    <style name="VeilText" parent="Widget.MaterialComponents.TextView">
        <item name="android:fontFamily">@font/onest</item>
    </style>

    <!-- Заголовок раздела в списках: «Выбрать вручную», «Ключ доступа». -->
    <style name="VeilSection">
        <item name="android:tag">fg</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/veil_text</item>
    </style>

    <!-- Строка внутри карточки настроек: название слева, значение справа. -->
    <style name="VeilRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">15dp</item>
        <item name="android:paddingEnd">15dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="VeilRowTitle">
        <item name="android:tag">fg</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/veil_text</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!--
        Таблетка-переключатель раздела или режима: ряд равных по ширине
        кнопок, активная залита акцентом. Цвета ставит код, здесь только форма.
    -->
    <style name="VeilPill">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/veil_muted</item>
    </style>

    <!-- Раздел на «Теме»: карточка с подписью капителью и рядом кнопок. -->
    <style name="ThemeSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:tag">card gap</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="ThemeSectionHead">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:baselineAligned">false</item>
    </style>

    <style name="ThemeK">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:tag">dim</item>
        <item name="android:fontFamily">@font/mono</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.16</item>
    </style>

    <!-- Подсказка справа от капители: занимает остаток строки и прижата к краю. -->
    <style name="ThemeHint">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:gravity">end</item>
        <item name="android:tag">dim</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ThemeRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="VeilRowSub">
        <item name="android:tag">dim</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textColor">@color/veil_muted</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
